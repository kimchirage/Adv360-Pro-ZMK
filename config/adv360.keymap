#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>



#define HYP LS(LC(LA(LGUI)))

#define HYPER(key) LS(LC(LA(LG(key))))

#define CRALS LS(LC(LALT))



/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };
        TD_1: TD_1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_1";
            #binding-cells = <0>;
            bindings = <&kp N1>, <&kp EXCLAMATION>;

            tapping-term-ms = <300>;
        };

        TD_2: TD_2 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_2";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_2>, <&kp AT_SIGN>;

            tapping-term-ms = <300>;
        };

        TD_3: TD_3 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_3";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_3>, <&kp HASH>;

            tapping-term-ms = <300>;
        };

        TD_4: TD_4 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_4";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_4>, <&kp DOLLAR>;

            tapping-term-ms = <300>;
        };

        TD_5: TD_5 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_5";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_5>, <&kp PERCENT>;

            tapping-term-ms = <300>;
        };

        TD_6: TD_6 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_6";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_6>, <&kp LCTRL>;

            tapping-term-ms = <300>;
        };

        TD_7: TD_7 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_7";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_7>, <&kp AMPERSAND>;

            tapping-term-ms = <300>;
        };

        TD_8: TD_8 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_8";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_8>, <&kp ASTERISK>;

            tapping-term-ms = <300>;
        };

        TD_9: TD_9 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_9";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_9>, <&kp LEFT_PARENTHESIS>;

            tapping-term-ms = <300>;
        };

        TD_0: TD_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_0";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_0>, <&kp RIGHT_PARENTHESIS>;

            tapping-term-ms = <300>;
        };

        SYM_ASTK: SYM_ASTK {
            compatible = "zmk,behavior-tap-dance";
            label = "SYM_ASTK";
            #binding-cells = <0>;
            bindings = <&kp ASTERISK>, <&kp SLASH>;

            tapping-term-ms = <300>;
        };

        SYM_UNDER: SYM_UNDER {
            compatible = "zmk,behavior-tap-dance";
            label = "SYM_UNDER";
            #binding-cells = <0>;
            bindings = <&kp UNDERSCORE>, <&kp BACKSLASH>;

            tapping-term-ms = <300>;
        };
    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
            bindings = <
&kp EQUAL      &kp N1         &kp N2          &kp N3    &kp N4     &kp N5  &tog 4                                                                      &mo 3        &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB        &kp Q          &kp W           &kp E     &kp R      &kp T   &Win_Copy                                                                   &Win_Cut     &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&mt CRALS ESC  &kp A          &kp S           &kp D     &kp F      &kp G   &Win_Paste    &mt LGUI LG(SPACE)  &kp LALT            &kp RCTRL  &kp LGUI   &Win_Undo    &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT      &kp Z          &kp X           &kp C     &kp V      &kp B                                     &mt LSHFT HOME      &kp PG_UP                          &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&tog 2         &mt HYP GRAVE  &mt CRALS CAPS  &kp LEFT  &kp RIGHT          &kp BSPC      &kp DEL             &mt LCTRL END       &kp PG_DN  &kp ENTER  &kp SPACE            &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &tog 2
            >;
        };
        /*layer1*/
    keypad {
      display-name = "Kp";
            bindings = <
&kp EQUAL      &kp EXCL   &kp AT    &kp POUND  &kp DLLR   &kp PRCNT  &trans                                                               &mo 3        &none      &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB        &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR   &kp RPAR   &Win_Copy                                                            &Win_Cut     &none      &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&mt CRALS ESC  &none      &none     &none      &kp LT     &kp GT     &Win_Paste    &kp LGUI  &kp LALT            &kp RCTRL  &mt HYP LGUI  &Win_Undo    &kp LEFT   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT      &none      &none     &kp UP     &kp LBKT   &kp RBKT                           &mt LSHFT HOME      &kp PG_UP                             &kp RIGHT  &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&tog 2         &none      &kp LEFT  &kp DOWN   &kp RIGHT             &kp TAB       &kp BSPC  &mt LCTRL END       &kp PG_DN  &kp ENTER     &kp SPACE               &none       &kp KP_N0     &kp KP_DOT     &none            &tog 2
            >;
        };

        /*layer2*/
    fn {
      display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3    &kp F4    &kp F5     &kp F6  &tog 4                                                        &mo 3       &kp F7  &kp F8    &kp F9    &kp F10    &kp F11  &kp F12
&trans  &trans  &trans    &trans    &trans     &trans  &Win_Copy                                                     &macro_hs1  &trans  &trans    &trans    &trans     &trans   &trans
&trans  &trans  &trans    &trans    &trans     &trans  &Win_Paste    &kp LGUI  &trans         &macro_scwb  &kp LGUI  &macro_hc1  &trans  &trans    &trans    &trans     &trans   &trans
&trans  &trans  &trans    &kp UP    &trans     &trans                          &kp LSHFT      &trans                             &trans  &trans    &kp UP    &trans     &trans   &trans
&trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT          &kp SPACE     &kp BSPC  &kp ENTER      &kp ENTER    &kp BSPC  &kp SPACE           &kp LEFT  &kp DOWN  &kp RIGHT  &trans   &trans
            >;
        };

        /*layer3*/
    mod {
      display-name = "Mod";
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                                  &trans                  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none
&none  &none         &none         &none         &none         &none         &bootloader                                                            &bootloader             &none         &none         &none         &none         &none         &none
&none  &none         &none         &none         &none         &none         &rgb_ug RGB_MEFS_CMD 5  &bt BT_CLR  &none      &bt BT_CLR  &bt BT_CLR  &rgb_ug RGB_MEFS_CMD 5  &none         &none         &none         &none         &none         &none
&none  &none         &none         &none         &none         &none                                             &none      &none                                           &none         &none         &none         &none         &none         &none
&none  &none         &none         &bl BL_INC    &bl BL_DEC                  &rgb_ug RGB_TOG         &bl BL_TOG  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                       &bl BL_INC    &bl BL_DEC    &none         &none         &none
            >;
        };
        sql {
	display-name = "SQL";
            bindings = <
&kp EQUAL  &TD_1      &TD_2       &TD_3     &TD_4      &TD_5  &trans                                                       &trans      &TD_6  &TD_7   &TD_8      &TD_9     &TD_0      &mt UNDERSCORE MINUS
&kp ESC    &kp Q      &kp W       &kp E     &kp R      &kp T  &Win_Copy                                                    &SYM_ASTK   &kp Y  &kp U   &kp I      &kp O     &kp P      &kp BSLH
&kp TAB    &kp A      &kp S       &kp D     &kp F      &kp G  &Win_Paste &trans   &trans               &trans     &trans   &SYM_UNDER  &kp H  &kp J   &kp K      &kp L     &kp SEMI   &kp SQT
&kp LSHFT  &kp Z      &kp X       &kp C     &kp V      &kp B                      &mt LSHIFT HOME      &kp PG_UP                       &kp N  &kp M   &kp COMMA  &kp DOT   &kp SLASH  &kp RIGHT_SHIFT
&tog 2     &kp GRAVE  &caps_word  &kp LEFT  &kp RIGHT         &kp BSPC   &kp DEL  &mt RCTRL END        &kp PG_DN  &kp RET  &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT   &trans
            >;
        };

    extra1 { 
      display-name = "Red";    
      status = "reserved";
    };

    extra2 { 
      display-name = "Purple";    
      status = "reserved";
    };

    extra3 { 
      display-name = "Cyan";    
      status = "reserved";
    };

    extra4 { 
      display-name = "Yellow";    
      status = "reserved";
    };
  };
};
